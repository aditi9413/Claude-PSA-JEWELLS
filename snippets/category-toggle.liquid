{%- comment -%}
  Usage:
    {% render 'category-toggle',
       left_label: 'Pooja & Aarti', left_url: '/collections/pooja-samagri',
       right_label: 'Jewellery',    right_url: '/collections/jewellery',
       active: 'left' %}
  active: 'left' or 'right' (which pill is highlighted on this page)
{%- endcomment -%}

{%- assign left_label  = left_label  | default: 'Pooja & Aarti' -%}
{%- assign right_label = right_label | default: 'Jewellery' -%}
{%- assign left_url    = left_url    | default: '/collections/pooja-samagri' -%}
{%- assign right_url   = right_url   | default: '/collections/jewellery' -%}
{%- assign active      = active      | default: 'left' -%}

<style>
.ct{--ct-active:#2d0a2e;--ct-active-fg:#fff;--ct-border:#c9a96a;--ct-fg:#2d0a2e;display:flex;justify-content:center;padding:10px 16px;box-sizing:border-box}
.ct-w{display:inline-flex;position:relative;border:1.5px solid var(--ct-border);border-radius:999px;padding:4px;background:#fff;max-width:100%;box-sizing:border-box}
.ct-b{display:inline-flex;align-items:center;justify-content:center;min-width:150px;padding:10px 26px;font-size:15px;font-weight:500;letter-spacing:.3px;color:var(--ct-fg);text-decoration:none;border-radius:999px;transition:background .25s ease,color .25s ease;white-space:nowrap}
.ct-b[aria-current="page"]{background:var(--ct-active);color:var(--ct-active-fg)}
.ct-b:focus-visible{outline:2px solid var(--ct-border);outline-offset:2px}
@media(max-width:768px){.ct{padding:8px 12px}.ct-b{min-width:0;flex:1 1 50%;padding:9px 12px;font-size:13px}.ct-w{display:flex;width:100%}}
</style>

<nav class="ct" aria-label="Category">
  <div class="ct-w">
    <a href="{{ left_url }}" class="ct-b"{% if active == 'left' %} aria-current="page"{% endif %}>{{ left_label }}</a>
    <a href="{{ right_url }}" class="ct-b"{% if active == 'right' %} aria-current="page"{% endif %}>{{ right_label }}</a>
  </div>
</nav>
