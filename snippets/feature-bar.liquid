<style>
  .feature-bar {
    overflow: hidden;
    position: relative;
    padding: 4px 0;
    margin: 8px 0 0;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .feature-track {
    display: flex;
    width: max-content;
    animation: feature-scroll 22s linear infinite;
    will-change: transform;
  }

  .feature-bar:hover .feature-track { animation-play-state: paused; }

  .feature-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 22px;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .feature-item img {
    height: 20px;
    width: auto;
    display: block;
  }

  .feature-item p {
    font-size: 11px;
    margin: 0;
    line-height: 1;
    letter-spacing: 0.3px;
  }

  @keyframes feature-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .feature-bar { padding: 3px 0; margin-top: 6px; }
    .feature-item { padding: 0 14px; gap: 5px; }
    .feature-item img { height: 18px; }
    .feature-item p { font-size: 10px; }
    .feature-track { animation-duration: 18s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-track { animation: none; transform: translateX(0); }
  }
</style>

