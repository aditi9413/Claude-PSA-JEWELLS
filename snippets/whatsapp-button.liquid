{%- assign wa_phone = '919999999999' -%}
{%- assign wa_default_message = 'Hi PSA Jewels! I have a question.' -%}

{%- capture wa_msg -%}
{%- if product -%}
Hi PSA Jewels! I'm interested in "{{ product.title }}" — {{ shop.url }}{{ product.url }}
{%- elsif template contains 'cart' -%}
Hi PSA Jewels! I need help with my cart.
{%- else -%}
{{ wa_default_message }}
{%- endif -%}
{%- endcapture -%}

<style>
.wa{position:fixed;right:16px;bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:90;display:inline-flex;align-items:center;gap:8px;background:#25D366;color:#fff;text-decoration:none;padding:12px 16px;border-radius:999px;box-shadow:0 6px 20px rgba(37,211,102,.4),0 2px 6px rgba(0,0,0,.12);font-family:inherit;font-size:13px;font-weight:600;line-height:1;transition:transform .2s ease,box-shadow .2s ease}
.wa:hover,.wa:focus{transform:translateY(-2px);color:#fff;box-shadow:0 10px 24px rgba(37,211,102,.5),0 2px 6px rgba(0,0,0,.15)}
.wa svg{width:22px;height:22px;flex:0 0 22px;fill:#fff;display:block}
.wa-t{white-space:nowrap}
.wa-p{position:absolute;inset:0;border-radius:999px;pointer-events:none;animation:wa-p 2.2s infinite}
@keyframes wa-p{0%{box-shadow:0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 0 0 14px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}
@media(max-width:767px){.wa{padding:12px;bottom:calc(82px + env(safe-area-inset-bottom,0px));right:12px}.wa-t{display:none}}
@media(min-width:768px){.wa{bottom:24px;right:24px}}
@media(prefers-reduced-motion:reduce){.wa-p{animation:none}.wa{transition:none}}
</style>

<a class="wa" href="https://wa.me/{{ wa_phone }}?text={{ wa_msg | strip_newlines | url_encode }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <span class="wa-p" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.5.1a8.2 8.2 0 0 1-4-3.5c-.3-.5.3-.5.8-1.6.1-.2.1-.4 0-.5s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.8.4 3.5 3.5 0 0 0-1.1 2.6c0 1.6 1.1 3 1.3 3.3a12.1 12.1 0 0 0 4.7 4.1c2.9 1.1 2.9.7 3.4.7a3 3 0 0 0 2-1.4 2.4 2.4 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3a8.2 8.2 0 1 1 6.9 3.8z"/></svg>
  <span class="wa-t">Chat with us</span>
</a>
