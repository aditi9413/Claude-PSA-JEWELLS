<style>
.bc{margin:14px 0;padding:14px 12px;background:#f1effc;border-radius:8px;font-family:inherit}
.bc-h{font-size:12px;font-weight:600;color:#38113d;margin:0 0 10px;text-transform:uppercase;letter-spacing:.6px;text-align:left}
.bc-list{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;scrollbar-width:thin}
.bc-list::-webkit-scrollbar{height:3px}
.bc-list::-webkit-scrollbar-thumb{background:rgba(56,17,61,.3);border-radius:2px}
.bc-c{flex:0 0 110px;display:flex;flex-direction:column;background:#fff;border-radius:6px;padding:6px;box-sizing:border-box}
.bc-c img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:4px;display:block;background:#f5f5f5}
.bc-link{text-decoration:none;color:inherit;display:block}
.bc-t{font-size:10px;margin:6px 0 2px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:#222;min-height:2.4em}
.bc-p{font-size:11px;font-weight:600;color:#111;margin-bottom:6px}
.bc-b{margin-top:auto;display:block;width:100%;padding:7px 4px;border:1px solid #38113d;background:#fff;color:#38113d;font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;text-align:center;border-radius:3px;cursor:pointer;text-decoration:none;font-family:inherit;box-sizing:border-box;transition:background .15s ease,color .15s ease}
.bc-b:hover:not(:disabled){background:#38113d;color:#fff}
.bc-b:disabled{opacity:.5;cursor:not-allowed}
.bc-b.added{background:#1b8a3b;border-color:#1b8a3b;color:#fff}
.bc[hidden]{display:none}
</style>

<section class="bc" id="bc" hidden aria-label="Cart suggestions">
  <div class="bc-h">Complete your order</div>
  <div class="bc-list" id="bc-list"></div>
</section>

<script>
(function(){
  var wrap=document.getElementById('bc'),list=document.getElementById('bc-list');
  if(!wrap||!list)return;
  var esc=function(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
  var inr=function(c){return '₹'+(c/100).toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:0})};
  var sized=function(u){return u?u.replace(/(\.[a-zA-Z]+)(\?|$)/,'_300x$1$2'):''};
  var loading=false;
  function load(){
    if(loading)return;loading=true;
    fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json()}).then(function(c){
      if(!c.items||!c.items.length){wrap.hidden=true;loading=false;return}
      var seed=c.items.slice().sort(function(a,b){return b.final_line_price-a.final_line_price})[0].product_id;
      var inCart={};c.items.forEach(function(i){inCart[i.product_id]=1});
      return fetch('/recommendations/products.json?product_id='+seed+'&intent=related&limit=6',{credentials:'same-origin'}).then(function(r){return r.ok?r.json():null}).then(function(j){
        var arr=(j&&j.products)||[];
        var picked=[];
        for(var i=0;i<arr.length&&picked.length<3;i++){
          var p=arr[i];
          if(!p||!p.id||inCart[p.id])continue;
          picked.push(p);
        }
        if(!picked.length){wrap.hidden=true;loading=false;return}
        list.innerHTML=picked.map(function(p){
          var v=null,vs=p.variants||[];for(var i=0;i<vs.length;i++){if(vs[i].available){v=vs[i];break}}
          var img=sized(p.featured_image||(p.images&&p.images[0])||''),title=esc(p.title||''),url='/products/'+encodeURIComponent(p.handle),price=v?v.price:p.price;
          var btn;
          if(!v){btn='<button class="bc-b" disabled type="button">Sold out</button>'}
          else if(vs.length===1){btn='<button class="bc-b" data-vid="'+v.id+'" type="button">Add</button>'}
          else{btn='<a class="bc-b" href="'+url+'">Choose</a>'}
          return '<div class="bc-c"><a class="bc-link" href="'+url+'"><img src="'+esc(img)+'" alt="'+title+'" loading="lazy"><div class="bc-t">'+title+'</div><div class="bc-p">'+inr(price)+'</div></a>'+btn+'</div>';
        }).join('');
        wrap.hidden=false;loading=false;
      });
    }).catch(function(){wrap.hidden=true;loading=false});
  }
  list.addEventListener('click',function(e){
    var b=e.target.closest('button.bc-b[data-vid]');
    if(!b||b.disabled)return;
    e.preventDefault();
    var id=b.getAttribute('data-vid'),orig=b.textContent;
    b.disabled=true;b.textContent='…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},credentials:'same-origin',body:JSON.stringify({id:parseInt(id,10),quantity:1})})
    .then(function(r){return r.ok?r.json():Promise.reject()})
    .then(function(){
      b.classList.add('added');b.textContent='✓';
      ['cart:updated','cart:refresh','cart:change','cart:item-added'].forEach(function(ev){try{document.dispatchEvent(new CustomEvent(ev,{bubbles:true}))}catch(_){}});
      setTimeout(function(){list.innerHTML='';load()},900);
    })
    .catch(function(){b.textContent='!';setTimeout(function(){b.textContent=orig;b.disabled=false},1500);});
  });
  ['cart:updated','cart:refresh','cart:change'].forEach(function(ev){document.addEventListener(ev,function(){if(loading)return;list.innerHTML='';load()})});
  load();
})();
</script>
