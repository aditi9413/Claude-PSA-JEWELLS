<style>
.rv{margin:28px 0;padding:0 16px;font-family:inherit}
.rv-h{font-size:14px;margin:0 0 14px;letter-spacing:1.2px;text-transform:uppercase;font-weight:600}
.rv-s{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:10px;scrollbar-width:thin}
.rv-s::-webkit-scrollbar{height:4px}
.rv-s::-webkit-scrollbar-thumb{background:#c9c9c9;border-radius:2px}
.rv-c{flex:0 0 150px;scroll-snap-align:start;text-decoration:none;color:inherit;display:block}
.rv-c img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:6px;display:block;background:#f5f5f5}
.rv-t{font-size:12px;margin:8px 0 3px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:#222}
.rv-p{font-size:13px;font-weight:600;color:#111}
.rv-pc{font-size:11px;color:#888;text-decoration:line-through;margin-left:4px;font-weight:400}
.rv[hidden]{display:none}
@media(min-width:768px){.rv{padding:0 24px;margin:40px 0}.rv-c{flex:0 0 200px}.rv-s{gap:16px}.rv-t{font-size:13px}.rv-p{font-size:14px}}
</style>

<section class="rv" id="rv" hidden aria-label="Recently viewed products">
  <div class="rv-h">Recently viewed</div>
  <div class="rv-s" id="rv-s"></div>
</section>

<script>
(function(){
  var K='psa_rv',MAX=8;
  {%- if product -%}
  var cur={{ product.handle | json }};
  {%- else -%}
  var cur=null;
  {%- endif -%}
  var list=[];
  try{list=JSON.parse(localStorage.getItem(K))||[]}catch(e){}
  if(!Array.isArray(list))list=[];
  if(cur){list=list.filter(function(x){return x!==cur});list.unshift(cur);list=list.slice(0,MAX+1);try{localStorage.setItem(K,JSON.stringify(list))}catch(e){}}
  var show=list.filter(function(x){return x!==cur}).slice(0,MAX);
  if(!show.length)return;
  var wrap=document.getElementById('rv'),strip=document.getElementById('rv-s');
  if(!wrap||!strip)return;
  var esc=function(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
  var inr=function(c){return '₹'+(c/100).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})};
  var sized=function(u){return u?u.replace(/(\.[a-zA-Z]+)(\?|$)/,'_400x$1$2'):''};
  Promise.all(show.map(function(h){return fetch('/products/'+encodeURIComponent(h)+'.js',{credentials:'same-origin'}).then(function(r){return r.ok?r.json():null}).catch(function(){return null})})).then(function(arr){
    var parts=arr.filter(function(p){return p&&p.available!==false&&p.handle}).map(function(p){
      var img=sized(p.featured_image||(p.images&&p.images[0])||''),title=esc(p.title||''),price=inr(p.price);
      var cmp=p.compare_at_price&&p.compare_at_price>p.price?'<span class="rv-pc">'+inr(p.compare_at_price)+'</span>':'';
      return '<a class="rv-c" href="/products/'+encodeURIComponent(p.handle)+'"><img src="'+esc(img)+'" alt="'+title+'" loading="lazy" width="400" height="400"><div class="rv-t">'+title+'</div><div class="rv-p">'+price+cmp+'</div></a>';
    });
    if(parts.length){strip.innerHTML=parts.join('');wrap.hidden=false}
  });
})();
</script>
