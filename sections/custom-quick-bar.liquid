<div id="quick-bar-link" class="quick-bar-container">
  <div class="quick-bar-wrapper quick-bar-multiple-items">
    {% for block in section.blocks %}
      {%- liquid
        assign label = block.settings.text | downcase
        assign on_jewellery_page = false
        if request.path contains '/pages/925-sterling-silver-jewellery-gifts'
          assign on_jewellery_page = true
        endif
        assign is_jewellery_icon = false
        if label contains '[j]'
          assign is_jewellery_icon = true
        endif
        assign show = false
        if on_jewellery_page and is_jewellery_icon
          assign show = true
        elsif on_jewellery_page == false and is_jewellery_icon == false
          assign show = true
        endif
        assign clean_label = block.settings.text | replace: '[J]', '' | replace: '[j]', '' | strip
      -%}
      {% if show %}
        <div class="quick-bar-item">
          <a href="{{ block.settings.link }}"></a>
          <img
            src="{{ block.settings.icon | img_url: '360x' }}"
            width="{{ block.settings.icon.width }}"
            height="{{ block.settings.icon.height }}"
            loading="lazy"
            alt="{{ clean_label | escape }}">
          <p>{{ clean_label }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .quick-bar-item img {
    width: 95px !important;
    height: 95px !important;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .quick-bar-item p {
    font-size: 14px !important;
    margin-top: 8px !important;
    font-weight: 500;
  }
  #shopify-section-{{ section.id }} .quick-bar-wrapper {
    gap: 24px;
    padding: 14px 0;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .quick-bar-item img {
      width: 72px !important;
      height: 72px !important;
    }
    #shopify-section-{{ section.id }} .quick-bar-item p {
      font-size: 12px !important;
      margin-top: 6px !important;
    }
    #shopify-section-{{ section.id }} .quick-bar-wrapper {
      gap: 14px;
      padding: 10px 0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const quickBarSection = document.querySelector("#shopify-section-{{ section.id }}");
    const announcementBarHeight = document.querySelector(".shopify-section-announcement-bar")?.offsetHeight || 0;
    const headerHeight = document.querySelector(".shopify-section-header")?.offsetHeight || 0;
    if (quickBarSection) {
      quickBarSection.style.height = "100%";
      quickBarSection.style.opacity = "1";
      quickBarSection.style.top = announcementBarHeight + headerHeight + "px";
    }

    const tryInitSlick = () => {
      if (window.innerWidth <= 768 && window.jQuery) {
        $('.quick-bar-multiple-items').slick({
          infinite: false,
          slidesToShow: 3.5,
          slidesToScroll: 3,
          arrows: false,
        });
      } else {
        setTimeout(tryInitSlick, 50);
      }
    };

    tryInitSlick();
  });
</script>

{% schema %}
{
  "name": "Custom Quick Bar",
  "settings": [],
  "blocks": [
    {
      "name": "Icon",
      "type": "icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text (prefix with [J] for Jewellery page only)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Quick Bar"
    }
  ]
}
{% endschema %}
