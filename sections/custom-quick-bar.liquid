<div id="quick-bar-link" class="quick-bar-container">
  <div class="quick-bar-wrapper quick-bar-multiple-items">
    {% for block in section.blocks %}
      {%- liquid
        assign label = block.settings.text | downcase
        assign on_jewellery_page = false
        if request.path contains '/pages/925-sterling-silver-jewellery-gifts'
          assign on_jewellery_page = true
        endif
        assign show = true
        if label contains '[j]' and on_jewellery_page == false
          assign show = false
        endif
        assign clean_label = block.settings.text | replace: '[J]', '' | replace: '[j]', '' | strip
      -%}
      {% if show %}
        <div class="quick-bar-item">
          <a href="{{ block.settings.link }}"></a>
          <img
            src="{{ block.settings.icon | img_url: '280x' }}"
            width="{{ block.settings.icon.width }}"
            height="{{ block.settings.icon.height }}"
            loading="lazy"
            alt="{{ clean_label | escape }}">
          <p>{{ clean_label }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% comment %} <style>
  #shopify-section-{{ section.id }} {
    overflow: hidden;
    position: sticky;
    top: 0;
    z-index: 2;
    background: white;
  }
</style> {% endcomment %}

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const quickBarSection = document.querySelector("#shopify-section-{{ section.id }}");
    const announcementBarHeight = document.querySelector(".shopify-section-announcement-bar")?.offsetHeight || 0;
    const headerHeight = document.querySelector(".shopify-section-header")?.offsetHeight || 0;
    if (quickBarSection) {
      quickBarSection.style.height = "100%";
      quickBarSection.style.opacity = "1";
      quickBarSection.style.top = announcementBarHeight + headerHeight + "px";
    }

    const tryInitSlick = () => {
      if (window.innerWidth <= 768 && window.jQuery) {
        $('.quick-bar-multiple-items').slick({
          infinite: false,
          slidesToShow: 3.5,
          slidesToScroll: 3,
          arrows: false,
        });
      } else {
        setTimeout(tryInitSlick, 50);
      }
    };

    tryInitSlick();
  });
</script>

{% schema %}
{
  "name": "Custom Quick Bar",
  "settings": [],
  "blocks": [
    {
      "name": "Icon",
      "type": "icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text (prefix with [J] to show only on Jewellery page)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Quick Bar"
    }
  ]
}
{% endschema %}
